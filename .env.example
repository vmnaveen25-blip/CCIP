# ==============================================================================
# CCIP / Astraea Enclave — Centralized Environment Configuration Template
# NOTE: Never commit genuine secrets or production keys into version control.
# Copy this file to .env and provide strong, unique secrets for production.
# ==============================================================================

# Application Environment (development | production | test)
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database Configuration
# Local SQLite for development; PostgreSQL for production containers
DATABASE_URL=sqlite+aiosqlite:///./ccip.db
SYNC_DATABASE_URL=sqlite:///./ccip.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://ccip_user:STRONG_UNIQUE_PASSWORD@postgres:5432/ccip_db
# SYNC_DATABASE_URL=postgresql://ccip_user:STRONG_UNIQUE_PASSWORD@postgres:5432/ccip_db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_DB=ccip_db
POSTGRES_USER=ccip_admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Authentication Secrets (Must be distinct, min 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_SECRET_KEY_FOR_JWT
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_32_CHAR_REFRESH_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Seeding Control (strictly prohibited in production)
ALLOW_DEMO_SEEDING=false

# Malware Scanning Engine (development | clamav)
MALWARE_SCANNER_TYPE=development
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Object Storage Vault (local | minio | gcs)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_vault
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_MINIO_SECRET_PASSWORD
MINIO_BUCKET=ccip-evidence-vault
MINIO_SECURE=false

# Google OAuth2 (Optional for citizen single-sign-on)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMS OTP Provider (development | twilio)
OTP_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI Assistant & Sovereign LLM Runtime
AI_ASSISTANT_API_KEY=
GEMINI_API_KEY=
INVESTIGATION_LLM_PROVIDER=local
INVESTIGATION_LLM_BASE_URL=http://127.0.0.1:11434
INVESTIGATION_LLM_MODEL=qwen2.5:7b
