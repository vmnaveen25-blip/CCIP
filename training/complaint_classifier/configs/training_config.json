{
  "base_model": "microsoft/deberta-v3-base",
  "task": "multi_label_classification",
  "max_length": 512,
  "seed": 42,
  "train_split": 0.8,
  "validation_split": 0.1,
  "test_split": 0.1,
  "pipeline_version": "1.0.0",
  "mapping_version": "1.0.0",
  "normalization_version": "1.0.0",
  "min_samples_per_label": 1000,
  "target_samples_per_label": 2000,
  "deduplication": {
    "near_dedup_similarity_threshold": 0.90,
    "enable_near_dedup": true
  },
  "pii_masking": {
    "mask_phone": false,
    "mask_email": false,
    "mask_upi": false,
    "mask_card": false,
    "mask_bank_account": false
  }
}
