# ==============================================================================
# CCIP Prototype Deployment Environment Configuration Template
# Strictly bound to 127.0.0.1 (Localhost Only)
# Never commit genuine secrets or production keys to version control.
# ==============================================================================

# Application Runtime Mode
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Localhost & 127.0.0.1 bindings)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL container)
POSTGRES_DB=ccip_db
POSTGRES_USER=ccip_admin
POSTGRES_PASSWORD=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_POSTGRES_PASSWORD

# Redis Cache & Background Tasks
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT Authentication Secrets (Must be distinct, min 32 chars, no insecure words)
JWT_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_JWT_KEY
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_CHAR_REFRESH_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Object Storage Vault (MinIO container)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_MINIO_PASSWORD
MINIO_BUCKET=ccip-evidence-vault
MINIO_SECURE=false

# Antivirus & Threat Scanning Engine (ClamAV container)
MALWARE_SCANNER_TYPE=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Demo Account Seeding Control (true only for synthetic local evaluation)
ALLOW_DEMO_SEEDING=false

# AI Assistant & Sovereign LLM Runtime
AI_ASSISTANT_API_KEY=astraea-sovereign-enclave-prototype-v2
INVESTIGATION_LLM_PROVIDER=local
INVESTIGATION_LLM_BASE_URL=http://127.0.0.1:11434
INVESTIGATION_LLM_MODEL=qwen2.5:7b
