# CCIP Backend Environment Configuration Template
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./ccip.db
SYNC_DATABASE_URL=sqlite:///./ccip.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & JWT
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_32_CHAR_SECRET_KEY_FOR_JWT
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_32_CHAR_REFRESH_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Seeding Control
ALLOW_DEMO_SEEDING=false

# Malware Scanning
MALWARE_SCANNER_TYPE=development
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_vault
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET_PASSWORD
MINIO_BUCKET=ccip-evidence-vault
MINIO_SECURE=false

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Optional Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OTP_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI & LLM Engine
AI_ASSISTANT_API_KEY=
GEMINI_API_KEY=
AI_ASSISTANT_MODEL=gemini-flash-lite-latest
INVESTIGATION_LLM_PROVIDER=local
INVESTIGATION_LLM_BASE_URL=http://127.0.0.1:11434
INVESTIGATION_LLM_MODEL=qwen2.5:7b
